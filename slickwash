          <label class="text-sm">
            <span class="block text-white/80">Email address</span>
            <input type="email" required class="mt-1 w-full rounded-xl border-0 bg-white/10 px-3 py-2 text-white ring-1 ring-inset ring-white/15 placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-cyan-300" placeholder="you@example.com">
          </label>
        </div>

        <label class="text-sm block">
          <span class="block text-white/80">Plan</span>
          <select id="planSelect" class="mt-1 w-full rounded-xl border-0 bg-white/10 px-3 py-2 text-white ring-1 ring-inset ring-white/15 focus:outline-none focus:ring-2 focus:ring-cyan-300">
            <option>Basic — R199/mo</option>
            <option selected>Pro — R349/mo</option>
            <option>Elite — R549/mo</option>
          </select>
        </label>

        <label class="text-sm block">
          <span class="block text-white/80">Vehicle plate</span>
          <input required class="mt-1 w-full rounded-xl border-0 bg-white/10 px-3 py-2 text-white uppercase ring-1 ring-inset ring-white/15 placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-cyan-300" placeholder="ABC 123 GP">
        </label>

        <button type="submit" class="mt-2 w-full rounded-xl bg-cyan-400 px-4 py-3 font-semibold text-slate-900 shadow">Send me a magic link</button>
        <p class="text-center text-xs text-white/60">By continuing you agree to our Terms and Privacy Policy.</p>
      </form>
    </div>
  </div>

  <!-- App Scripts -->
  <script>
    // Activate icons
    lucide.createIcons();

    // Year
    document.getElementById('year').textContent = new Date().getFullYear();

    // Pro per-wash hint
    (function(){
      var pricePro = 349; // keep in sync with markup
      var perWash = Math.round((pricePro / 4) * 100) / 100;
      var el = document.getElementById('proPerWashHint');
      if(el) el.textContent = 'Pro averages ~R' + perWash + ' per wash.';
    })();

    // Modal logic
    const modal = document.getElementById('signupModal');
    const openBtns = [document.getElementById('openSignupBtn'), document.getElementById('openSignupBtnFooter'), document.getElementById('getStartedBtn')];
    const closeBtn = document.getElementById('closeSignupBtn');
    const planSelect = document.getElementById('planSelect');

    openBtns.forEach(btn => btn && btn.addEventListener('click', () => {
      modal.classList.remove('hidden');
    }));
    closeBtn.addEventListener('click', () => modal.classList.add('hidden'));
    modal.addEventListener('click', (e) => {
      if(e.target === modal) modal.classList.add('hidden');
    });

    // Select plan from pricing cards
    document.querySelectorAll('.selectPlan').forEach(btn => {
      btn.addEventListener('click', () => {
        const plan = btn.getAttribute('data-plan');
        const mapping = { Basic: 0, Pro: 1, Elite: 2 };
        planSelect.selectedIndex = mapping[plan] ?? 1;
        modal.classList.remove('hidden');
      });
    });

    // Fake submit (demo)
    document.getElementById('signupForm').addEventListener('submit', function(e){
      e.preventDefault();
      const plan = planSelect.options[planSelect.selectedIndex].text.split(' — ')[0];
      alert("Thanks! We'll email you shortly about the " + plan + " plan.");
      modal.classList.add('hidden');
      this.reset();
    });

    // Keyboard accessibility: close on Escape
    document.addEventListener('keydown', (e)=>{
      if(e.key === 'Escape' && !modal.classList.contains('hidden')) modal.classList.add('hidden');
    });
  </script>
</body>
</html>
